{
  "expo": {
    "name": "Deep Focus",
    "slug": "deep-focus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/deep-focus-icon.png",
    "scheme": "deepfocus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/deep-focus-icon.png",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/deep-focus-splash.png",
        "monochromeImage": "./assets/images/deep-focus-splash.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.randunukaushan9.DeepFocus"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#031226",
          "android": {
            "image": "./assets/images/deep-focus-brand-reference.png",
            "imageWidth": 240
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4f5a788d-8977-47d1-8d77-4915b35a945d"
      }
    },
    "owner": "randunukaushan9"
  }
}

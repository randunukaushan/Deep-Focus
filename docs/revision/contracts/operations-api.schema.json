            },
            "status": {
              "const": "rejected"
            },
            "code": {
              "$ref": "#/definitions/SafeErrorCode"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mutationId",
            "command",
            "targetId",
            "status",
            "code"
          ],
          "properties": {
            "mutationId": {
              "$ref": "#/definitions/Id"

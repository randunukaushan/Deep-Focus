    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Secret": {
      "type": "string",
      "minLength": 43,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Synthetic shape only; production requires server CSPRNG, protected storage, redaction, approved expiry and secret lifecycle."
    },
    "HttpsUrl": {
      "type": "string",
      "format": "uri",
      "maxLength": 4096,
      "pattern": "^https://",
      "description": "Shape is not an origin/redirect allowlist; server validates exact authorized destination."
    },
    "SyncOutcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,

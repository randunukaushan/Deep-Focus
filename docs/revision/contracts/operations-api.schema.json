    "SnapshotStatusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "job",
            "snapshot"
          ],
          "properties": {
            "job": {
              "$ref": "#/definitions/SnapshotJob"
            },
            "snapshot": {
              "anyOf": [
                {
                  "$ref": "#/definitions/SnapshotMeta"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "job": {
                    "properties": {
                      "state": {
                        "const": "succeeded"
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "snapshot": {
                    "$ref": "#/definitions/SnapshotMeta"
                  }
                }
              },
              "else": {
                "properties": {
                  "snapshot": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      }
    },

        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mutationId",
            "command",
            "targetId",
            "body"
          ],
          "properties": {
            "mutationId": {
              "$ref": "urn:deep-focus:personal-api:2026-09-15#/definitions/Id"
            },
            "command": {
              "const": "plan.restore"
            },
            "targetId": {
              "$ref": "urn:deep-focus:personal-api:2026-09-15#/definitions/Id"
            },
            "body": {
              "allOf": [
                {
                  "$ref": "urn:deep-focus:plan-management:2026-09-19#/definitions/PlanActionInput"
                },
                {
                  "properties": {
                    "action": {
                      "const": "restore"
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mutationId",
            "command",
            "targetId",
            "body"
          ],
          "properties": {
            "mutationId": {
              "$ref": "urn:deep-focus:personal-api:2026-09-15#/definitions/Id"
            },
            "command": {
              "const": "plan.delete"
            },
            "targetId": {
              "$ref": "urn:deep-focus:personal-api:2026-09-15#/definitions/Id"
            },
            "body": {
              "allOf": [
                {
                  "$ref": "urn:deep-focus:plan-management:2026-09-19#/definitions/PlanActionInput"
                },
                {
                  "properties": {
                    "action": {
                      "const": "delete"
                    }
                  }
                }
              ]
            }
          }
        }
      ]

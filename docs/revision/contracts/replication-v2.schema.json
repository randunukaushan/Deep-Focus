    "Mutation": {
      "oneOf": [
        {
          "$ref": "urn:deep-focus:backend-extensions:2026-09-16#/definitions/SyncMutation"
        },
        {
          "$ref": "#/definitions/PlanMutation"
        }
      ]
    },
    "PushInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "privacyEpoch",

            },
            "version": {
              "$ref": "urn:deep-focus:personal-api:2026-09-15#/definitions/Version"
            },
            "operation": {
              "const": "upsert"
            },
            "payload": {
              "$ref": "urn:deep-focus:planning:2026-09-19#/definitions/SavedPlan"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sequence",
            "entity",
            "entityId",
            "version",
            "operation",
            "payload"
          ],
          "properties": {
            "sequence": {
              "$ref": "urn:deep-focus:backend-extensions:2026-09-16#/definitions/Sequence"
            },
            "entity": {
              "const": "plan"
            },
            "entityId": {
              "$ref": "urn:deep-focus:personal-api:2026-09-15#/definitions/Id"
            },
            "version": {
              "$ref": "urn:deep-focus:personal-api:2026-09-15#/definitions/Version"
            },
            "operation": {
              "const": "delete"
            },
            "payload": {
              "type": "null"
            }
          }
        }
      ]

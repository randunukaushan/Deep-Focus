            "command": {
              "const": "plan.archive"
            },
            "targetId": {
              "$ref": "urn:deep-focus:personal-api:2026-09-15#/definitions/Id"
            },
            "body": {
              "allOf": [
                {
                  "$ref": "urn:deep-focus:plan-management:2026-09-19#/definitions/PlanActionInput"

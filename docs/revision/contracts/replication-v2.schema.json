      ],
      "properties": {
        "contractVersion": {
          "const": 2
        },
        "privacyEpoch": {
          "$ref": "#/definitions/Epoch"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {
            "$ref": "#/definitions/Mutation"
          }
        }
      }
    },
    "PlanOutcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mutationId",
            "command",
            "targetId",
            "status",
            "receipt"
          ],
          "properties": {
            "mutationId": {
              "$ref": "urn:deep-focus:personal-api:2026-09-15#/definitions/Id"
            },
            "command": {
              "enum": [
                "plan.edit",
                "plan.archive",
                "plan.restore",
                "plan.delete"
              ]

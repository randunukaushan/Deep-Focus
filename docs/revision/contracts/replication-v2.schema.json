        "firstPageCursor": {
          "$ref": "urn:deep-focus:backend-extensions:2026-09-16#/definitions/Cursor"
        },
        "resumeCursor": {
          "$ref": "urn:deep-focus:backend-extensions:2026-09-16#/definitions/Cursor"
        }
      }
    },
    "SnapshotStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "privacyEpoch",
            "job",
            "snapshot"
          ],
          "properties": {
            "contractVersion": {
              "const": 2
            },
            "privacyEpoch": {
              "$ref": "#/definitions/Epoch"
            },
            "job": {
              "$ref": "urn:deep-focus:operations-api:2026-09-18#/definitions/SnapshotJob"
            },
            "snapshot": {
              "anyOf": [
                {
                  "$ref": "#/definitions/SnapshotMeta"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "job": {
                    "properties": {
                      "state": {
                        "const": "succeeded"
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "snapshot": {
                    "$ref": "#/definitions/SnapshotMeta"
                  }
                }
              },
              "else": {
                "properties": {
                  "snapshot": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        }
      }
    },

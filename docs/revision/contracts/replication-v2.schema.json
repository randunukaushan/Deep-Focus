    "PullResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",
        "meta"
      ],
      "properties": {
        "data": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/ChangeGroup"
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "privacyEpoch",
            "highWater",
            "nextCursor",
            "caughtUp"

          "properties": {
            "contractVersion": {
              "const": 2
            },
            "privacyEpoch": {
              "$ref": "#/definitions/Epoch"
            },
            "highWater": {
              "$ref": "urn:deep-focus:backend-extensions:2026-09-16#/definitions/Sequence"
            },
            "nextCursor": {
              "$ref": "urn:deep-focus:backend-extensions:2026-09-16#/definitions/Cursor"
            },
            "caughtUp": {
              "type": "boolean"
            }
          }
        }
      }

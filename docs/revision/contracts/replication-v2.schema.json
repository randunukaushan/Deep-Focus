      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "privacyEpoch",
            "job"
          ],
          "properties": {
            "contractVersion": {
              "const": 2
            },
            "privacyEpoch": {
              "$ref": "#/definitions/Epoch"
            },
            "job": {
              "$ref": "urn:deep-focus:operations-api:2026-09-18#/definitions/SnapshotJob"

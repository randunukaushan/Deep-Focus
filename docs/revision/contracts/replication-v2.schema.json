      "properties": {
        "cursor": {
          "$ref": "urn:deep-focus:backend-extensions:2026-09-16#/definitions/Cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      }
    },
    "PageQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor"
      ],
      "properties": {
        "cursor": {
          "$ref": "urn:deep-focus:backend-extensions:2026-09-16#/definitions/Cursor"
        }
      }
    },
    "PlanListQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "state": {
          "enum": [
            "active",
            "archived",
            "all"
          ],
          "default": "active"
        },
        "cursor": {
          "$ref": "urn:deep-focus:backend-extensions:2026-09-16#/definitions/Cursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      }

              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "pageCount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "highWater": {
              "$ref": "urn:deep-focus:backend-extensions:2026-09-16#/definitions/Sequence"
            },
            "pageDigest": {
              "$ref": "urn:deep-focus:operations-api:2026-09-18#/definitions/Digest"
            },
            "nextCursor": {
              "anyOf": [
                {
                  "$ref": "urn:deep-focus:backend-extensions:2026-09-16#/definitions/Cursor"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "PlanList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data",

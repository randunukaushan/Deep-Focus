        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "privacyEpoch",
            "nextCursor"
          ],
          "properties": {
            "contractVersion": {
              "const": 2
            },
            "privacyEpoch": {
              "$ref": "#/definitions/Epoch"
            },
            "nextCursor": {
              "anyOf": [
                {
                  "$ref": "urn:deep-focus:backend-extensions:2026-09-16#/definitions/Cursor"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }

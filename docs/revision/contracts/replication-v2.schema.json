            "targetId": {
              "$ref": "urn:deep-focus:personal-api:2026-09-15#/definitions/Id"
            },
            "status": {
              "enum": [
                "applied",
                "replayed"
              ]
            },
            "receipt": {
              "$ref": "urn:deep-focus:plan-management:2026-09-19#/definitions/MutationReceipt"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mutationId",
            "command",
            "targetId",
            "status",
            "code"
          ],
          "properties": {
            "mutationId": {
              "$ref": "urn:deep-focus:personal-api:2026-09-15#/definitions/Id"
            },
            "command": {
              "enum": [
                "plan.edit",
                "plan.archive",
                "plan.restore",
                "plan.delete"
              ]
            },
            "targetId": {
              "$ref": "urn:deep-focus:personal-api:2026-09-15#/definitions/Id"
            },
            "status": {
              "const": "rejected"
            },
            "code": {
              "$ref": "urn:deep-focus:operations-api:2026-09-18#/definitions/SafeErrorCode"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mutationId",
            "command",
            "targetId",
            "status",
            "code"
          ],
          "properties": {
            "mutationId": {
              "$ref": "urn:deep-focus:personal-api:2026-09-15#/definitions/Id"
            },
            "command": {
              "enum": [
                "plan.edit",
                "plan.archive",
                "plan.restore",
                "plan.delete"
              ]
            },
            "targetId": {
              "$ref": "urn:deep-focus:personal-api:2026-09-15#/definitions/Id"
            },
            "status": {
              "const": "retryable"
            },
            "code": {
              "$ref": "urn:deep-focus:operations-api:2026-09-18#/definitions/SafeErrorCode"
            },
            "retryAfterSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        }
      ]
    },
    "Outcome": {
      "oneOf": [
        {
          "$ref": "urn:deep-focus:operations-api:2026-09-18#/definitions/SyncOutcome"
        },

      "properties": {
        "pageIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "plans": {
          "type": "array",
          "minItems": 0,
          "maxItems": 100,
          "items": {
            "$ref": "urn:deep-focus:planning:2026-09-19#/definitions/SavedPlan"

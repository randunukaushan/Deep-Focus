    "/plans": {
      "get": {
        "operationId": "listDailyPlans",
        "x-replication-id": "RP-06",
        "x-active-account-required": true,
        "x-unknown-query-keys": "reject",
        "parameters": [
          {
            "name": "Plan-Contract-Version",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "const": 2
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "active",
                "archived",
                "all"
              ],
              "default": "active"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "urn:deep-focus:backend-extensions:2026-09-16#/definitions/Cursor"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50

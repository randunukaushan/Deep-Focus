          }
        ],
        "responses": {
          "200": {
            "description": "Owned protocol-2 result; not proof of runtime or OS effects.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "Plan-Contract-Version": {
                "schema": {
                  "type": "integer",
                  "const": 2
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "replication-v2.schema.json#/definitions/PlanList"
                }
              }
            }
          },
          "default": {

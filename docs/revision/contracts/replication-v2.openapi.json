  "components": {
    "securitySchemes": {
      "UserBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Supabase user access JWT"
      }
    },
    "responses": {
      "Error": {
        "description": "Shared safe error; owner/session/epoch authorization still required.",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "private, no-store"
            }
          }
        },
        "content": {

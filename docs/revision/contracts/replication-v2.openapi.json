            "required": true,
            "schema": {
              "$ref": "urn:deep-focus:backend-extensions:2026-09-16#/definitions/Cursor"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }

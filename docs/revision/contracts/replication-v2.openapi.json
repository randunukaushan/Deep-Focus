      "get": {
        "operationId": "readReplicaSnapshotPageV2",
        "x-replication-id": "RP-05",
        "x-active-account-required": true,
        "x-unknown-query-keys": "reject",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": true,

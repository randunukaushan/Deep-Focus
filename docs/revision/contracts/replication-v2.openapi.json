{
  "openapi": "3.1.1",
  "info": {
    "title": "Deep Focus draft replication v2",
    "version": "0.1.0-draft"
  },
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "security": [
    {
      "UserBearer": []
    }
  ],
  "paths": {
    "/replication/v2/push": {
      "post": {
        "operationId": "pushReplicaV2",
        "x-replication-id": "RP-01",
        "x-active-account-required": true,
        "x-unknown-query-keys": "reject",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned protocol-2 result; not proof of runtime or OS effects.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "replication-v2.schema.json#/definitions/PushResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "replication-v2.schema.json#/definitions/PushInput"
              }
            }
          }
        },
        "x-max-body-bytes": 65536
      }
    },
    "/replication/v2/pull": {
      "get": {
        "operationId": "pullReplicaV2",
        "x-replication-id": "RP-02",
        "x-active-account-required": true,

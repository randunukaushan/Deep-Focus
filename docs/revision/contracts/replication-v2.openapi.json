                "$ref": "replication-v2.schema.json#/definitions/SnapshotCreate"
              }
            }
          }
        },
        "x-max-body-bytes": 65536
      }
    },
    "/replication/v2/snapshots/{id}": {
      "get": {
        "operationId": "readReplicaSnapshotV2",
        "x-replication-id": "RP-04",
        "x-active-account-required": true,
        "x-unknown-query-keys": "reject",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"

              "application/json": {
                "schema": {
                  "$ref": "replication-v2.schema.json#/definitions/PullResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/replication/v2/snapshots": {
      "post": {
        "operationId": "createReplicaSnapshotV2",
        "x-replication-id": "RP-03",
        "x-active-account-required": true,
        "x-unknown-query-keys": "reject",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"

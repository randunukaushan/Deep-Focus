    "DeferredFamily": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family",
            "disposition",
            "policyRef"
          ],
          "properties": {
            "family": {
              "enum": [
                "ai_activity",
                "consent_history",
                "billing_records",
                "cloud_resources",
                "shared_workspaces",
                "support_records",
                "telemetry",
                "connector_data"
              ]
            },
            "disposition": {
              "const": "not_collected"
            },
            "policyRef": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "family",
            "disposition",
            "policyRef"
          ],
          "properties": {
            "family": {
              "enum": [
                "ai_activity",
                "consent_history",
                "billing_records",
                "cloud_resources",
                "shared_workspaces",
                "support_records",
                "telemetry",
                "connector_data"
              ]
            },
            "disposition": {
              "const": "separate_process"
            },
            "policyRef": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,99}@[1-9][0-9]{0,8}$"
            }
          }
        }
      ]
    },

  "definitions": {
    "Identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "email",
        "phone",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "$ref": "urn:deep-focus:personal-api:2026-09-15#/definitions/Id"
        },
        "email": {
          "anyOf": [
            {
              "type": "string",
              "format": "email",
              "maxLength": 320
            },
            {
              "type": "null"
            }
          ]
        },
        "phone": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\+[1-9][0-9]{1,14}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "$ref": "urn:deep-focus:planning:2026-09-19#/definitions/UtcInstant"
        },
        "updatedAt": {
          "$ref": "urn:deep-focus:planning:2026-09-19#/definitions/UtcInstant"
        }
      }
    },
    "FocusEvent": {
      "type": "object",
      "additionalProperties": false,

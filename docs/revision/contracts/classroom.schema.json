      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "messageKey",
            "requestId",
            "retryable"
          ],
          "properties": {
            "code": {
              "enum": [
                "VALIDATION_FAILED",
                "AUTH_REQUIRED",
                "NOT_FOUND",
                "POLICY_REQUIRED",
                "VERSION_CONFLICT",
                "INVALID_TRANSITION",
                "COMMAND_CONFLICT",
                "COMMAND_EXPIRED",
                "INVITATION_UNAVAILABLE",
                "RATE_LIMITED",
                "DEPENDENCY_UNAVAILABLE"
              ]
            },
            "messageKey": {
              "type": "string",
              "pattern": "^errors\\.[A-Za-z0-9.]+$",
              "maxLength": 120
            },
            "requestId": {
              "$ref": "#/definitions/Id"
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "SubmissionView": {
      "oneOf": [

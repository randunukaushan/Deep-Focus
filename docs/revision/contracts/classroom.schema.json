{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:deep-focus:classroom:2026-09-30",
  "title": "Bounded classroom wire DTOs — DRAFT",
  "description": "CW-00 documentation only. Engineering representation caps, not measured production quotas. Domain authorization, actual IANA validity, privacy, locks and policy checks are separate. No SQL or app implementation.",
  "definitions": {
    "Id": {
      "type": "string",
      "format": "uuid"
    },
    "Version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "Instant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "Title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "\\S"
    },
    "Instructions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "FeedbackText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "DisplayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "TimeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_+./-]+$"
    },
    "Token": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "Cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "PageQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20
        },
        "cursor": {
          "$ref": "#/definitions/Cursor"
        }
      }
    },
    "Due": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at",
            "timeZone"
          ],
          "properties": {
            "at": {
              "$ref": "#/definitions/Instant"
            },
            "timeZone": {
              "$ref": "#/definitions/TimeZone"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "AssignmentContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [

# Server-side Edge Function configuration template. Copy values only into the
# Supabase project secret store or an ignored local file; never into mobile env.
SUPABASE_DB_URL=postgresql://postgres:replace-with-server-only-connection@host:6543/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEYS={"default":"sb_publishable_replace_with_project_key"}
DEEP_FOCUS_SYNC_CURSOR_SECRET=replace-with-a-random-server-only-secret-at-least-32-characters
DEEP_FOCUS_LIST_CURSOR_SECRET=replace-with-a-different-random-server-only-secret-at-least-32-characters
DEEP_FOCUS_SNAPSHOT_CURSOR_SECRET=replace-with-another-random-server-only-secret-at-least-32-characters
DEEP_FOCUS_GATEWAY_RATE_LIMIT_WINDOW_MS=60000
DEEP_FOCUS_GATEWAY_RATE_LIMIT=120
DEEP_FOCUS_SYNC_CURSOR_TTL_MS=900000
